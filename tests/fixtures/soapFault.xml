<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixture: a SOAP fault reply (HTTP 500 body from the Organization.svc). The
  parser must treat this as "not a record collection" and return null so the
  caller falls back to the raw-XML view.
-->
<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" xmlns:a="http://schemas.microsoft.com/xrm/2011/Contracts" xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
  <s:Body>
    <s:Fault>
      <faultcode xmlns:a="http://schemas.microsoft.com/CrmServices/2011/2/Contracts">a:QueryNotSupported</faultcode>
      <faultstring>Error</faultstring>
      <detail>
        <OperationReturnedAnError xmlns="http://schemas.microsoft.com/xrm/2011/Contracts">
          <ErrorCode>-2147217111</ErrorCode>
          <ErrorText xmlns:d="http://www.w3.org/2001/XMLSchema" i:nil="true"/>
        </OperationReturnedAnError>
      </detail>
    </s:Fault>
  </s:Body>
</s:Envelope>
