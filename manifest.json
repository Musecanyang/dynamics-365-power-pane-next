{
  "manifest_version": 3,
  "name": "Dynamics 365 Power Pane Next",
  "short_name": "Power Pane Next",
  "version": "1.0.1",
  "description": "In-page action pane, diagnostics and real user impersonation for Microsoft Dynamics 365 / Dataverse.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.dynamics.com/*"],
      "js": ["content/main-world.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.dynamics.com/*"],
      "js": ["src/constants.js", "src/actions.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Dynamics 365 Power Pane Next",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
